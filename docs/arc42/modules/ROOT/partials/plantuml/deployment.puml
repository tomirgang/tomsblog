@startuml deployment
node "Hetzner K8s Cluster (3 Nodes)" {
  node "Namespace: tomsblog" {
    [Blog Content Service] as blog
    [User Management Service] as usermgmt
    [Tenant Management Service] as tenantmgmt
    [Feed Service] as feed
    [AI Service] as ai
  }

  node "Namespace: postgres" {
    database "PostgreSQL\n(blog-content,\nCloudNativePG)" as db_blog
    database "PostgreSQL\n(user-mgmt,\nCloudNativePG)" as db_user
    database "PostgreSQL\n(tenant-mgmt,\nCloudNativePG)" as db_tenant
    database "PostgreSQL\n(feed,\nCloudNativePG)" as db_feed
  }

  node "Namespace: redis" {
    [Redis] as redis
  }

  node "Namespace: kafka" {
    queue "Kafka\n(Strimzi)" as kafka
  }

  node "Namespace: rabbitmq" {
    queue "RabbitMQ\n(Cluster Operator)" as rabbitmq
  }

  node "Namespace: auth" {
    [Authentik\n(OIDC Provider)] as authentik
  }

  node "Namespace: observability" {
    [Prometheus] as prom
    [Grafana] as grafana
    [Loki] as loki
    [Tempo] as tempo
  }
}

node "Netcup VM" {
  [Garage (S3)] as s3
}

cloud "OpenRouter" as openrouter

blog --> db_blog
usermgmt --> db_user
tenantmgmt --> db_tenant
feed --> db_feed
blog --> usermgmt : gRPC
blog --> tenantmgmt : gRPC
usermgmt --> authentik : OIDC
blog --> kafka
blog --> rabbitmq
feed --> kafka
ai --> kafka
ai --> rabbitmq
ai --> openrouter
blog --> redis
usermgmt --> redis
blog --> s3 : Attachments
db_blog --> s3 : Backups
db_user --> s3 : Backups
@enduml
