@startuml
package "Blog Content Service" {
  package "domain/model" {
    [Post] <<Aggregate Root>>
    [Translation] <<Aggregate Root>>
    [Tag] <<Entity>>
    [PostId] <<Value Object>>
    [TagId] <<Value Object>>
    [TranslationId] <<Value Object>>
    [AttachmentId] <<Value Object>>
    [Slug] <<Value Object>>
    [PostLocale] <<Value Object>>
    [Source] <<Value Object>>
    [Attachment] <<Value Object>>
    [ContentType] <<Enum>>
    [PostStatus] <<Enum>>
    [TranslationStatus] <<Enum>>
    [TranslationSource] <<Enum>>
  }

  package "domain/event" {
    [PostCreatedEvent]
    [PostPublishedEvent]
    [PostUpdatedEvent]
    [TranslationCreatedEvent]
    [TranslationApprovedEvent]
  }

  package "application/port/inbound" {
    [PostUseCase] <<Port>>
    [TagUseCase] <<Port>>
    [TranslationUseCase] <<Port>>
    [CreatePostCommand]
    [UpdatePostCommand]
    [AddSourceCommand]
    [RemoveSourceCommand]
    [CreateTagCommand]
    [RenameTagCommand]
    [CreateTranslationCommand]
    [UpdateTranslationCommand]
  }

  package "application/port/outbound" {
    [PostRepository] <<Port>>
    [TagRepository] <<Port>>
    [TranslationRepository] <<Port>>
    [EventPublisher] <<Port>>
    [MarkdownRenderer] <<Port>>
  }

  package "application/service" {
    [PostService]
    [TagService]
    [TranslationService]
    [PostNotFoundException]
    [TagNotFoundException]
    [TranslationNotFoundException]
  }

  package "adapter/inbound/rest" {
    [PostController]
    [TagController]
    [TranslationController]
    [SourceController]
    [GlobalExceptionHandler]
    [OpenApiConfiguration]
  }

  package "adapter/inbound/web" {
    [BlogViewController]
    [AdminController]
    [LoginController]
    [LegalController]
    [SecurityConfiguration]
    [DefaultTenantFilter]
    [LoginRateLimitFilter]
    [SyncingOidcUserService]
    [AdminProperties]
    [TenantBrandingAdvice]
    [VersionModelAdvice]
    [PostFormData]
  }

  package "adapter/outbound/persistence" {
    [JpaPostRepository]
    [JpaTagRepository]
    [JpaTranslationRepository]
    [SpringDataPostRepository]
    [SpringDataTagRepository]
    [SpringDataTranslationRepository]
    [PostJpaEntity]
    [TagJpaEntity]
    [TranslationJpaEntity]
    [PostMapper]
    [TagMapper]
    [TranslationMapper]
    [LoggingEventPublisher]
  }

  package "adapter/outbound/markdown" {
    [FlexmarkMarkdownRenderer]
  }

  package "adapter/outbound/usermanagement" {
    [UserManagementGrpcClient]
  }
}

note right of [Post]
  AuthorId (shared-kernel),
  Set<TagId>, List<Source>,
  List<Attachment>
end note

note right of [Attachment]
  show=true: angezeigt
  show=false: eingebettet
end note

[PostController] --> [PostUseCase]
[TagController] --> [TagUseCase]
[TranslationController] --> [TranslationUseCase]
[SourceController] --> [PostUseCase]
[BlogViewController] --> [PostUseCase]
[BlogViewController] --> [MarkdownRenderer]
[AdminController] --> [UserManagementGrpcClient]
[PostService] ..|> [PostUseCase]
[TagService] ..|> [TagUseCase]
[TranslationService] ..|> [TranslationUseCase]
[PostService] --> [PostRepository]
[PostService] --> [EventPublisher]
[PostService] --> [Post]
[TagService] --> [TagRepository]
[TranslationService] --> [TranslationRepository]
[TranslationService] --> [EventPublisher]
[JpaPostRepository] ..|> [PostRepository]
[JpaTagRepository] ..|> [TagRepository]
[JpaTranslationRepository] ..|> [TranslationRepository]
[LoggingEventPublisher] ..|> [EventPublisher]
[FlexmarkMarkdownRenderer] ..|> [MarkdownRenderer]
[Post] --> [PostCreatedEvent]
[Post] --> [PostPublishedEvent]
[Post] --> [PostUpdatedEvent]
[Translation] --> [TranslationCreatedEvent]
[Translation] --> [TranslationApprovedEvent]
[Translation] --> [TranslationCreatedEvent]
[Translation] --> [TranslationApprovedEvent]
@enduml
