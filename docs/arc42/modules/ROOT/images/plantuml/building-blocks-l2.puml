@startuml
package "Blog Content Service" {
  package "domain/model" {
    [Post] <<Aggregate Root>>
    [Translation] <<Aggregate Root>>
    [Tag] <<Entity>>
    [PostId] <<Value Object>>
    [TagId] <<Value Object>>
    [TranslationId] <<Value Object>>
    [AttachmentId] <<Value Object>>
    [Slug] <<Value Object>>
    [PostLocale] <<Value Object>>
    [Source] <<Value Object>>
    [Attachment] <<Value Object>>
    [PostStatus] <<Enum>>
    [TranslationStatus] <<Enum>>
    [TranslationSource] <<Enum>>
  }

  package "domain/event" {
    [PostCreatedEvent]
    [PostPublishedEvent]
    [PostUpdatedEvent]
    [TranslationCreatedEvent]
    [TranslationApprovedEvent]
  }

  package "application/port/inbound" {
    [PostUseCase] <<Port>>
    [CreatePostCommand]
    [UpdatePostCommand]
  }

  package "application/port/outbound" {
    [PostRepository] <<Port>>
    [TagRepository] <<Port>>
    [TranslationRepository] <<Port>>
    [EventPublisher] <<Port>>
  }

  package "application/service" {
    [PostService]
    [PostNotFoundException]
  }

  package "adapter/inbound/rest" {
    [PostController]
    [GlobalExceptionHandler]
  }

  package "adapter/outbound/persistence" {
    [JpaPostRepository]
    [SpringDataPostRepository]
    [PostJpaEntity]
    [PostMapper]
    [LoggingEventPublisher]
  }
}

note right of [Post]
  AuthorId (shared-kernel),
  Set<TagId>, List<Source>,
  List<Attachment>
end note

note right of [Attachment]
  show=true: angezeigt
  show=false: eingebettet
end note

[PostController] --> [PostUseCase]
[PostService] ..|> [PostUseCase]
[PostService] --> [PostRepository]
[PostService] --> [EventPublisher]
[PostService] --> [Post]
[JpaPostRepository] ..|> [PostRepository]
[LoggingEventPublisher] ..|> [EventPublisher]
[Post] --> [PostCreatedEvent]
[Post] --> [PostPublishedEvent]
[Post] --> [PostUpdatedEvent]
[Translation] --> [TranslationCreatedEvent]
[Translation] --> [TranslationApprovedEvent]
@enduml
